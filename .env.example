NODE_ENV=production
PORT=4000
TRUST_PROXY=1

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_ACCESS_KEY=replace-with-a-long-random-access-key
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
VITE_ADMIN_PATH=/_secure-admin-7f29A228lswP

DB_PATH=/app/data/regola.db
UPLOAD_DIR=/app/data/uploads

# Telegram notifications
TELEGRAM_BOT_TOKEN=
# Optional Telegram-compatible transport proxy. Leave empty to use https://api.telegram.org.
TELEGRAM_BOT_API_BASE_URL=
# Main administrator chat. The bot sends notifications here and accepts its commands.
TELEGRAM_CHAT_ID=
# Optional additional administrators, comma-separated. Example: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=

# Email notifications (new orders and questions). For Mail.ru use smtp.mail.ru,
# port 465, SMTP_SECURE=true and an app password created in Mail.ru settings.
EMAIL_TO=regola-shop@mail.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional sender address. Defaults to SMTP_USER.
EMAIL_FROM=

# Public HTTPS origin used in payment callbacks
PUBLIC_BASE_URL=https://regola.shop

# T-Bank acquiring. Use test with a DEMO key; switch to production only with the enabled working terminal.
TBANK_MODE=production
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_TAXATION=
TBANK_ITEM_TAX=
TBANK_DELIVERY_TAX=
# Optional override. DEMO terminals automatically use securepay.tinkoff.ru.
TBANK_API_URL=

# Address suggestions through DaData (server-side secret token)
DADATA_TOKEN=

# CDEK API v2. Delivery is available only to pickup points. Keep test mode until shipment tests are accepted.
CDEK_MODE=test
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_CITY_CODE=137
CDEK_TARIFF_PVZ=136
CDEK_PACKAGE_WEIGHT_G=500
CDEK_PACKAGE_LENGTH_CM=17
CDEK_PACKAGE_WIDTH_CM=14
CDEK_PACKAGE_HEIGHT_CM=7
CDEK_SHIPMENT_POINT=SPB206
CDEK_SENDER_NAME=Гюльтекин Хайдар
CDEK_SENDER_PHONE=+79829412000
